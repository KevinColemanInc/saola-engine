# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
wheels/

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime data and logs
src/data/*
!src/data/.gitkeep
*.log
*.pid

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo


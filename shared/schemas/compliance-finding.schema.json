{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saola.local/schemas/compliance-finding.schema.json",
  "title": "ComplianceFinding",
  "type": "object",
  "required": ["id", "country", "topic", "summary", "evidenceUrls", "confidence"],
  "properties": {
    "id": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "enum": [
        "aml",
        "kyc",
        "sanctions",
        "licensing",
        "reporting",
        "stablecoins",
        "custody",
        "travel_rule",
        "tax",
        "consumer_protection",
        "other"
      ]
    },
    "summary": {
      "type": "string"
    },
    "regulator": {
      "type": "string"
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "requiredAction": {
      "type": "string"
    },
    "evidenceUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needsHumanReview": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saola.local/schemas/news-article.schema.json",
  "title": "NewsArticle",
  "type": "object",
  "required": ["url", "title", "sourceDomain", "publishedAt"],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "sourceDomain": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "bodyText": {
      "type": "string"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
